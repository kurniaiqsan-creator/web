# ====== Visi — contoh konfigurasi environment ======
# Salin file ini menjadi `.env` lalu sesuaikan nilainya.
# `.env` di-ignore git (lihat .gitignore). JANGAN commit kredensial asli.

# --- Aplikasi ---
APP_URL=http://localhost:8080
# Base URL path bila app diakses dari subdirectory (mis. /visi). Kosongkan kalau root.
APP_BASE_URL=
JWT_SECRET=visi-dev-secret-key-change-in-production

# --- Database ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=visi
DB_USER=root
DB_PASS=

# --- Payment Gateway (sandbox; biarkan kosong sampai keys tersedia) ---
# Provider default: midtrans | xendit | doku
PG_PROVIDER=midtrans
PG_SERVER_KEY=
PG_CLIENT_KEY=

# --- Notifikasi (biarkan kosong sampai keys tersedia) ---
# Email transaksional via SMTP (Gmail). Aktifkan 2FA lalu buat App Password 16 digit.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=Visi Tickets
# WhatsApp via Fonnte (https://fonnte.com). Token per device, lihat dashboard Fonnte.
FONNTE_TOKEN=
