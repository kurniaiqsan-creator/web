# ====== Visi — contoh konfigurasi environment ======
# Salin file ini menjadi `.env` lalu sesuaikan nilainya.
# `.env` di-ignore git (lihat .gitignore). JANGAN commit kredensial asli.

# --- Aplikasi ---
APP_URL=http://localhost:8080
# Base URL path bila app diakses dari subdirectory (mis. /visi). Kosongkan kalau root.
APP_BASE_URL=
JWT_SECRET=visi-dev-secret-key-change-in-production

# --- Database ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=visi
DB_USER=root
DB_PASS=

# --- Payment Gateway: Pakasir (https://pakasir.com) ---
# Slug & API key dari halaman detail Proyek di app.pakasir.com.
# Bisa juga diisi per-tenant di Pengaturan > Payment Gateway.
PAKASIR_SLUG=
PAKASIR_API_KEY=
# Set 1 untuk mode sandbox (mengizinkan simulasi pembayaran lewat /api/v1/payments/simulate).
PAKASIR_SANDBOX=0
# Opsional override base URL (default https://app.pakasir.com).
PAKASIR_BASE_URL=

# --- Notifikasi (biarkan kosong sampai keys tersedia) ---
# Email transaksional via SMTP (Gmail). Aktifkan 2FA lalu buat App Password 16 digit.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=Visi Tickets
# WhatsApp via Fonnte (https://fonnte.com). Token per device, lihat dashboard Fonnte.
FONNTE_TOKEN=
